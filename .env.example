# Скопируйте в .env и при необходимости поменяйте значения:
#   cp .env.example .env

# Порт веб-интерфейса (nginx) на хосте
APP_PORT=8080

# Параметры PostgreSQL
POSTGRES_USER=refs
POSTGRES_PASSWORD=refspass
POSTGRES_DB=refs
# Порт PostgreSQL на хосте (закомментируйте в docker-compose.yml, если не нужен)
POSTGRES_PORT=5432
