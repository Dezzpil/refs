# Скопируйте этот файл в .env и при необходимости измените значения:
#   cp .env.example .env

# Имя контейнера
POSTGRES_CONTAINER_NAME=postgres_dev

# Учётные данные и имя базы данных
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_db

# Порт PostgreSQL на хосте (измените, если 5432 занят)
POSTGRES_PORT=5432
